<?xml version="1.0" encoding="utf-8"?>
<score-partwise version="4.0">
  <work>
    <work-number>GTR-TAB-001</work-number>
    <work-title>Guitar and TAB Feature Catalogue</work-title>
  </work>
  <movement-number>1</movement-number>
  <movement-title>MusicXML 4.0 Guitar and TAB Coverage</movement-title>
  <identification>
    <creator type="composer">Guitar TAB Editor Project</creator>
    <creator type="arranger">Fixture Authors</creator>
    <rights>Original synthetic examples for testing; CC0-1.0.</rights>
    <encoding>
      <encoding-date>2026-10-08</encoding-date>
      <software>Guitar TAB Editor fixture</software>
      <encoding-description>Hand-authored MusicXML 4.0 feature catalogue.</encoding-description>
      <supports type="yes" element="print" attribute="new-system" value="yes"/>
    </encoding>
    <miscellaneous>
      <miscellaneous-field name="scope">Representative guitar, tablature, rhythm, expression, text, harmony, layout and flow examples; not every MusicXML element or a continuous performance score. Heel and toe are preservation examples, not guitar performance instructions.</miscellaneous-field>
      <miscellaneous-field name="navigation">Navigation commands are independent coverage examples; no single concert playback route is intended.</miscellaneous-field>
      <miscellaneous-field name="tuning">Staff lines run bottom to top; guitar strings run highest to lowest. Staff line 1 is string 6. Pitches include capo transposition in TAB-STANDARD only.</miscellaneous-field>
    </miscellaneous>
  </identification>
  <defaults>
    <scaling><millimeters>7</millimeters><tenths>40</tenths></scaling>
    <page-layout>
      <page-height>1697.14</page-height><page-width>1200</page-width>
      <page-margins type="both">
        <left-margin>80</left-margin><right-margin>80</right-margin>
        <top-margin>80</top-margin><bottom-margin>80</bottom-margin>
      </page-margins>
    </page-layout>
    <system-layout>
      <system-margins><left-margin>0</left-margin><right-margin>0</right-margin></system-margins>
      <system-distance>120</system-distance><top-system-distance>100</top-system-distance>
    </system-layout>
    <staff-layout number="2"><staff-distance>80</staff-distance></staff-layout>
    <appearance>
      <line-width type="stem">1.2</line-width>
      <line-width type="staff">0.8</line-width>
      <note-size type="cue">75</note-size>
      <distance type="hyphen">4</distance>
    </appearance>
    <music-font font-family="Bravura" font-size="20"/>
    <word-font font-family="serif" font-size="10"/>
  </defaults>
  <credit page="1">
    <credit-type>title</credit-type>
    <credit-words default-x="600" default-y="1600" justify="center" valign="top" font-size="18">Guitar and TAB Feature Catalogue</credit-words>
  </credit>
  <part-list>
    <score-part id="P1">
      <part-name>Guitar</part-name>
      <part-abbreviation>Gtr.</part-abbreviation>
      <score-instrument id="P1-I1">
        <instrument-name>Acoustic Guitar</instrument-name>
        <instrument-abbreviation>Gtr.</instrument-abbreviation>
        <instrument-sound>pluck.guitar.acoustic</instrument-sound>
      </score-instrument>
      <midi-device id="P1-I1" port="1">General MIDI</midi-device>
      <midi-instrument id="P1-I1">
        <midi-channel>1</midi-channel><midi-program>25</midi-program><volume>80</volume><pan>0</pan>
      </midi-instrument>
    </score-part>
  </part-list>
  <part id="P1">
    <!-- META-LAYOUT: layout and preservation nodes, with two explicit staves. -->
    <measure number="1" implicit="yes" width="280">
      <print new-system="yes" new-page="yes">
        <system-layout>
          <system-margins><left-margin>40</left-margin><right-margin>0</right-margin></system-margins>
          <top-system-distance>100</top-system-distance>
        </system-layout>
        <staff-layout number="2"><staff-distance>80</staff-distance></staff-layout>
        <measure-numbering>system</measure-numbering>
      </print>
      <attributes>
        <divisions>8</divisions>
        <key><fifths>0</fifths><mode>major</mode></key>
        <time><beats>4</beats><beat-type>4</beat-type></time>
        <staves>2</staves>
        <part-symbol top-staff="1" bottom-staff="2">bracket</part-symbol>
        <clef number="1"><sign>G</sign><line>2</line><clef-octave-change>-1</clef-octave-change></clef>
        <clef number="2"><sign>TAB</sign><line>5</line></clef>
        <staff-details number="2" show-frets="numbers">
          <staff-lines>6</staff-lines>
          <staff-tuning line="1"><tuning-step>E</tuning-step><tuning-octave>2</tuning-octave></staff-tuning>
          <staff-tuning line="2"><tuning-step>A</tuning-step><tuning-octave>2</tuning-octave></staff-tuning>
          <staff-tuning line="3"><tuning-step>D</tuning-step><tuning-octave>3</tuning-octave></staff-tuning>
          <staff-tuning line="4"><tuning-step>G</tuning-step><tuning-octave>3</tuning-octave></staff-tuning>
          <staff-tuning line="5"><tuning-step>B</tuning-step><tuning-octave>3</tuning-octave></staff-tuning>
          <staff-tuning line="6"><tuning-step>E</tuning-step><tuning-octave>4</tuning-octave></staff-tuning>
          <capo>2</capo>
        </staff-details>
      </attributes>
      <direction placement="above"><direction-type><rehearsal color="#1F618D">META-LAYOUT</rehearsal></direction-type><staff>1</staff></direction>
      <bookmark id="fixture-layout" name="Layout and metadata"/>
      <grouping type="single" number="1"><feature type="coverage">layout-preservation</feature></grouping>
      <note>
        <pitch><step>E</step><octave>4</octave></pitch><duration>8</duration><voice>1</voice><type>quarter</type>
        <notehead-text><display-text>E</display-text></notehead-text><staff>1</staff>
      </note>
      <backup><duration>8</duration></backup>
      <note><rest/><duration>8</duration><voice>2</voice><type>quarter</type><staff>2</staff></note>
    </measure>

    <!-- TAB-STANDARD: open tuning is non-capo; the sounding notes include capo 2. -->
    <measure number="2">
      <direction placement="above"><direction-type><rehearsal>TAB-STANDARD</rehearsal></direction-type><staff>2</staff></direction>
      <direction><direction-type><words>Standard E A D G B E; capo 2; frets relative to capo.</words></direction-type><staff>2</staff></direction>
      <note><pitch><step>F</step><alter>1</alter><octave>4</octave></pitch><duration>8</duration><voice>1</voice><type>quarter</type><accidental>sharp</accidental><staff>2</staff><notations><technical><string>1</string><fret>0</fret></technical></notations></note>
      <note><pitch><step>G</step><alter>1</alter><octave>4</octave></pitch><duration>8</duration><voice>1</voice><type>quarter</type><accidental>sharp</accidental><staff>2</staff><notations><technical><string>1</string><fret>2</fret></technical></notations></note>
      <note><pitch><step>A</step><octave>4</octave></pitch><duration>8</duration><voice>1</voice><type>quarter</type><staff>2</staff><notations><technical><string>1</string><fret>3</fret></technical></notations></note>
      <note><pitch><step>B</step><octave>4</octave></pitch><duration>8</duration><voice>1</voice><type>quarter</type><staff>2</staff><notations><technical><string>1</string><fret>5</fret></technical></notations></note>
    </measure>

    <!-- RHYTHM-DURATIONS includes a 3/4 bar at divisions 16, then restores 4/4 and 8. -->
    <measure number="3">
      <attributes><staff-details number="2"><capo>0</capo></staff-details></attributes>
      <direction placement="above"><direction-type><rehearsal>RHYTHM-DURATIONS</rehearsal></direction-type><staff>1</staff></direction>
      <direction><direction-type><words>Remove capo for the remaining examples.</words></direction-type><staff>2</staff></direction>
      <note><pitch><step>E</step><octave>4</octave></pitch><duration>32</duration><voice>1</voice><type>whole</type><staff>1</staff></note>
    </measure>
    <measure number="4">
      <note><pitch><step>E</step><octave>4</octave></pitch><duration>16</duration><voice>1</voice><type>half</type><staff>1</staff></note>
      <note><pitch><step>F</step><octave>4</octave></pitch><duration>8</duration><voice>1</voice><type>quarter</type><staff>1</staff></note>
      <note><pitch><step>G</step><octave>4</octave></pitch><duration>4</duration><voice>1</voice><type>eighth</type><staff>1</staff></note>
      <note><pitch><step>A</step><octave>4</octave></pitch><duration>2</duration><voice>1</voice><type>16th</type><staff>1</staff></note>
      <note><pitch><step>B</step><octave>4</octave></pitch><duration>1</duration><voice>1</voice><type>32nd</type><staff>1</staff></note>
      <note><rest/><duration>1</duration><voice>1</voice><type>32nd</type><staff>1</staff></note>
    </measure>
    <measure number="5">
      <attributes>
        <divisions>16</divisions>
        <key><fifths>2</fifths><mode>major</mode></key>
        <time><beats>3</beats><beat-type>4</beat-type></time>
      </attributes>
      <!-- C-sharp and D-flat sound alike but keep their distinct spellings. Total: 48 divisions. -->
      <note><pitch><step>C</step><alter>1</alter><octave>4</octave></pitch><duration>24</duration><voice>1</voice><type>quarter</type><dot/><accidental>sharp</accidental><staff>1</staff></note>
      <note><pitch><step>D</step><alter>-1</alter><octave>4</octave></pitch><duration>14</duration><voice>1</voice><type>eighth</type><dot/><dot/><accidental>flat</accidental><staff>1</staff></note>
      <note><rest/><duration>8</duration><voice>1</voice><type>eighth</type><staff>1</staff></note>
      <note><rest/><duration>2</duration><voice>1</voice><type>32nd</type><staff>1</staff></note>
    </measure>

    <measure number="6">
      <attributes>
        <divisions>8</divisions>
        <key><fifths>0</fifths><mode>major</mode></key>
        <time><beats>4</beats><beat-type>4</beat-type></time>
      </attributes>
      <direction placement="above"><direction-type><rehearsal>RHYTHM-GRACE-CUE</rehearsal></direction-type><staff>1</staff></direction>
      <note><grace slash="yes"/><pitch><step>G</step><octave>4</octave></pitch><voice>1</voice><type>eighth</type><staff>1</staff></note>
      <note><grace slash="no"/><pitch><step>A</step><octave>4</octave></pitch><voice>1</voice><type>eighth</type><staff>1</staff></note>
