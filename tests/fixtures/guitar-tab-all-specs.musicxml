      <direction placement="above"><direction-type><rehearsal>RHYTHM-TUPLETS</rehearsal></direction-type><staff>1</staff></direction>
      <!-- 8 divisions is retained: 3 triplet durations total exactly 8; 5 quintuplets total 16. -->
